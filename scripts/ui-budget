#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DEFAULT_MD = ROOT / "ios/docs/ui-flow-budget.md"
DEFAULT_XCRESULT = ROOT / "ios/DerivedData/PeriMedi.xcresult"
FLOW_HEADING = "## Flow"
BUDGET_FENCE = re.compile(r"^```budget\n(.*?)^```", re.M | re.S)
ROW = re.compile(r"^\|\s*(.*?)\s*\|\s*([0-9]+(?:\.[0-9]+)?)\s*\|")


def parse_budget(text: str) -> dict[str, str]:
    matched = BUDGET_FENCE.search(text)
    if matched is None:
        raise SystemExit("missing ```budget fence")
    out: dict[str, str] = {}
    for line in matched.group(1).splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        out[key.strip()] = value.strip()
    return out


SIGNED_ROW = re.compile(r"^\|\s*(.*?)\s*\|\s*(-?[0-9]+(?:\.[0-9]+)?)\s*\|")


def table_rows(text: str, heading: str, *, signed: bool = False) -> list[tuple[str, float]]:
    lines = text.splitlines()
    try:
        start = lines.index(heading)
    except ValueError as exc:
        raise SystemExit(f"missing {heading}") from exc
    row_re = SIGNED_ROW if signed else ROW
    rows: list[tuple[str, float]] = []
    seen_separator = False
    for line in lines[start + 1 :]:
        if not line.startswith("|"):
            if rows:
                break
            continue
        if re.fullmatch(r"\|\s*-+\s*\|.*", line):
            seen_separator = True
            continue
        if not seen_separator:
            continue
        matched = row_re.match(line)
        if matched is None:
            raise SystemExit(f"{heading} row has no seconds: {line}")
        rows.append((matched.group(1), float(matched.group(2))))
    if not rows:
        raise SystemExit(f"{heading} table is empty")
    return rows


def flow_rows(text: str) -> list[tuple[str, float]]:
    return table_rows(text, FLOW_HEADING)


def need_float(keys: dict[str, str], name: str) -> float:
    try:
        return float(keys[name])
    except (KeyError, ValueError) as exc:
        raise SystemExit(f"budget fence missing {name}") from exc


def fmt(value: float) -> str:
    return f"{value:.3f}".rstrip("0").rstrip(".")


def xcresult_duration(path: Path) -> str:
    if not path.exists():
        return "none"
    command = [
        "xcrun",
        "xcresulttool",
        "get",
        "test-results",
        "tests",
        "--path",
        str(path),
        "--format",
        "json",
    ]
    try:
        completed = subprocess.run(command, check=False, capture_output=True, text=True)
    except OSError as exc:
        return f"unreadable ({exc})"
    if completed.returncode != 0:
        err = (completed.stderr or completed.stdout).strip().splitlines()
        detail = err[-1] if err else f"exit {completed.returncode}"
        return f"unreadable ({detail})"
    try:
        payload = json.loads(completed.stdout)
    except json.JSONDecodeError:
        return "unreadable (not json)"
    found = find_duration(payload, "testUserFlow")
    if found is None:
        return "no testUserFlow"
    return fmt(found)


def find_duration(node: object, name: str) -> float | None:
    if isinstance(node, dict):
        node_name = str(node.get("name") or node.get("identifier") or "")
        if name in node_name:
            for key in ("duration", "durationInSeconds"):
                raw = node.get(key)
                if isinstance(raw, (int, float)):
                    return float(raw)
                if isinstance(raw, str):
                    try:
                        return float(raw)
                    except ValueError:
                        pass
        for value in node.values():
            found = find_duration(value, name)
            if found is not None:
                return found
    elif isinstance(node, list):
        for item in node:
            found = find_duration(item, name)
            if found is not None:
                return found
    return None


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--md", type=Path, default=DEFAULT_MD)
    parser.add_argument("--xcresult", type=Path, default=DEFAULT_XCRESULT)
    args = parser.parse_args()
    text = args.md.read_text(encoding="utf-8")
    keys = parse_budget(text)
    rows = flow_rows(text)
    body = sum(seconds for _, seconds in rows)
    body_declared = need_float(keys, "body-s")
    warm_rows = table_rows(text, "## Warm exact hit")
    warm_sum = sum(seconds for _, seconds in warm_rows)
    warm_wall = need_float(keys, "warm-wall-s")
    warm2_rows = table_rows(text, "## Second warm exact hit")
    warm2_sum = sum(seconds for _, seconds in warm2_rows)
    warm2_wall = need_float(keys, "warm2-wall-s")
    cut_rows = table_rows(text, "## Paper cuts", signed=True)
    paper = warm2_sum + sum(seconds for _, seconds in cut_rows)
    paper_declared = need_float(keys, "paper-s")

    print(f"rows: {len(rows)}")
    for name, seconds in rows:
        print(f"  {fmt(seconds):>8}  {name}")
    print(f"body-s: {fmt(body)}")
    print(f"warm-s: {fmt(warm_sum)}")
    for name, seconds in warm_rows:
        print(f"  {fmt(seconds):>8}  {name}")
    print(f"warm2-s: {fmt(warm2_sum)}")
    for name, seconds in warm2_rows:
        print(f"  {fmt(seconds):>8}  {name}")
    print(f"paper-s: {fmt(paper)}")
    for name, seconds in cut_rows:
        print(f"  {fmt(seconds):>8}  {name}")
    measured = xcresult_duration(args.xcresult)
    print(f"xcresult: {measured}")
    if measured not in {"none", "no testUserFlow"} and not measured.startswith("unreadable"):
        try:
            actual = float(measured)
        except ValueError:
            actual = None
        if actual is not None and body > 0:
            gap = abs(actual - body) / body
            print(f"xcresult-vs-body: {gap:.1%}")

    if abs(body - body_declared) > 0.05:
        print(
            f"flow table sums to {fmt(body)}, fence says {fmt(body_declared)}",
            file=sys.stderr,
        )
        return 1
    if abs(warm_sum - warm_wall) > 0.05:
        print(
            f"warm table sums to {fmt(warm_sum)}, fence says {fmt(warm_wall)}",
            file=sys.stderr,
        )
        return 1
    if abs(warm2_sum - warm2_wall) > 0.05:
        print(
            f"second warm table sums to {fmt(warm2_sum)}, fence says {fmt(warm2_wall)}",
            file=sys.stderr,
        )
        return 1
    if abs(paper - paper_declared) > 0.05:
        print(
            f"paper sums to {fmt(paper)}, fence says {fmt(paper_declared)}",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
